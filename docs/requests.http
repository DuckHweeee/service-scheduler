### Unified Service Scheduler - runnable walkthrough
# VS Code "REST Client" (humao.rest-client) / JetBrains HTTP client. Run the requests top to bottom.
#
# Setup (pins "now" to Thu 2026-10-08 09:00 Asia/Ho_Chi_Minh so same-day examples work at any time of day):
#   pnpm db:up && pnpm db:migrate && pnpm db:seed
#   CLOCK_OVERRIDE=2026-10-08T09:00:00+07:00 pnpm --filter @scheduler/api start
# The seed is generated relative to the clock; if you seed on another day, change the two dates below
# (futureDate must be a working day within the booking horizon, a few working days after "today").
# The flow cancels what it books. To run it again, first change idemKey below (a reused key replays the old
# appointment, which is already cancelled).

@base = http://localhost:3000
@api = {{base}}/api/v1
@today = 2026-10-08
@futureDate = 2026-10-14
@json = application/json
@idemKey = walkthrough-key-1

### 1. Reference data ----------------------------------------------------------------------------------

# 200 {items}: 3 dealerships with hours, timezone, bayCount and sameDayPolicy
GET {{api}}/dealerships

###
# 200 {items}: 8 service types (isExpress, powertrains, durationMin)
GET {{api}}/service-types

###
# 200 customer Linh Tran
GET {{api}}/customers/CUS-10482

###
# 200 {items}: VEH-01 Crossover LX (ICE), VEH-02 Compact EV (EV)
GET {{api}}/customers/CUS-10482/vehicles

### 2. Availability ------------------------------------------------------------------------------------

# Future day: 200, sameDay = null, slots with status AVAILABLE / NO_BAY / ... and a non-binding "proposed" bay + technician
GET {{api}}/dealerships/DLR-01/availability?serviceType=OIL_CHANGE&date={{futureDate}}&vehicleId=VEH-01

###
# Same day (clock pinned to 09:00): 200, sameDay.earliestStartTime = 11:00 (2 h lead time), slots are express slots
GET {{api}}/dealerships/DLR-01/availability?serviceType=OIL_CHANGE&date={{today}}&vehicleId=VEH-01

###
# Blocked same day (non-express service): 200, sameDay.blocked = "SERVICE_NOT_EXPRESS", slots = []
GET {{api}}/dealerships/DLR-01/availability?serviceType=BRAKE_PAD_REPLACEMENT&date={{today}}&vehicleId=VEH-01

###
# Non-working day (Sunday) is not an error: 200, isWorkingDay = false, slots = []
GET {{api}}/dealerships/DLR-01/availability?serviceType=OIL_CHANGE&date=2026-10-11&vehicleId=VEH-01

###
# Beyond the booking horizon: 422 problem+json, code OUTSIDE_BOOKING_HORIZON
GET {{api}}/dealerships/DLR-01/availability?serviceType=OIL_CHANGE&date=2026-12-30&vehicleId=VEH-01

### 3. Book, conflict, idempotent replay ---------------------------------------------------------------

# 201 AppointmentDetail, status CONFIRMED, channel ADVANCE, with technician, serviceBay and history
# @name book
POST {{api}}/appointments
Content-Type: {{json}}
Idempotency-Key: {{idemKey}}

{
  "customerId": "CUS-10482",
  "vehicleId": "VEH-01",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{futureDate}}",
  "startTime": "08:00",
  "bookingSessionId": "11111111-1111-4111-8111-111111111111"
}

###
@reference = {{book.response.body.reference}}

# Idempotent replay: same Idempotency-Key => 200 with the original appointment (same reference), nothing new created
POST {{api}}/appointments
Content-Type: {{json}}
Idempotency-Key: {{idemKey}}

{
  "customerId": "CUS-10482",
  "vehicleId": "VEH-01",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{futureDate}}",
  "startTime": "08:00",
  "bookingSessionId": "11111111-1111-4111-8111-111111111111"
}

###
# Conflict: another customer asks for the same slot => 409 SLOT_UNAVAILABLE, reason (e.g. NO_BAY) and up to 5 alternatives
POST {{api}}/appointments
Content-Type: {{json}}

{
  "customerId": "CUS-10001",
  "vehicleId": "VEH-03",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{futureDate}}",
  "startTime": "08:00",
  "bookingSessionId": "22222222-2222-4222-8222-222222222222"
}

###
# Same vehicle, overlapping time (no Idempotency-Key): 409 VEHICLE_ALREADY_BOOKED
POST {{api}}/appointments
Content-Type: {{json}}

{
  "customerId": "CUS-10482",
  "vehicleId": "VEH-01",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{futureDate}}",
  "startTime": "08:00",
  "bookingSessionId": "11111111-1111-4111-8111-111111111111"
}

### 4. Detail, list -------------------------------------------------------------------------------------

# 200 AppointmentDetail with the event history (SLOT_REQUESTED, CHECK_PASSED, RESOURCES_RESERVED, APPOINTMENT_CREATED, ...)
GET {{api}}/appointments/{{reference}}

###
# 200 {items}, upcoming first
GET {{api}}/appointments?customerId=CUS-10482&status=CONFIRMED

###
# Unknown reference: 404 NOT_FOUND
GET {{api}}/appointments/APT-00000000-0000

### 5. Cancel ------------------------------------------------------------------------------------------

# 200, status CANCELLED, cancelledAt set, slot is free again
POST {{api}}/appointments/{{reference}}/cancel
Content-Type: {{json}}

{ "reason": "Customer rescheduled" }

###
# Idempotent: cancelling again => 200, unchanged
POST {{api}}/appointments/{{reference}}/cancel

###
# Check-in of a cancelled appointment: 409 APPOINTMENT_NOT_ACTIVE
POST {{api}}/appointments/{{reference}}/check-in

### 6. Check-in ----------------------------------------------------------------------------------------

# @name bookEv
POST {{api}}/appointments
Content-Type: {{json}}

{
  "customerId": "CUS-10482",
  "vehicleId": "VEH-02",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "GENERAL_INSPECTION",
  "date": "{{futureDate}}",
  "startTime": "08:00",
  "bookingSessionId": "33333333-3333-4333-8333-333333333333"
}

###
@evReference = {{bookEv.response.body.reference}}

# 200, checkedInAt set (advance bookings are never auto-released)
POST {{api}}/appointments/{{evReference}}/check-in

###
# Second check-in: 409 APPOINTMENT_NOT_ACTIVE ("already checked in")
POST {{api}}/appointments/{{evReference}}/check-in

###
# Tidy up so the walkthrough can be re-run: 200 CANCELLED
POST {{api}}/appointments/{{evReference}}/cancel

### 7. Inventory and same-day parts --------------------------------------------------------------------

# 200 {items}: onHand / reserved / available per SKU
GET {{api}}/dealerships/DLR-01/inventory

###
# Simulated DMS sync: set the Crossover oil filter to 0 => 200
PUT {{api}}/dealerships/DLR-01/inventory/FLT-OIL-CX22
Content-Type: {{json}}

{ "onHand": 0 }

###
# Same-day availability now reports sameDay.blocked = "PARTS_UNAVAILABLE", slots = []
GET {{api}}/dealerships/DLR-01/availability?serviceType=OIL_CHANGE&date={{today}}&vehicleId=VEH-01

###
# Same-day booking is refused: 409 PARTS_UNAVAILABLE
POST {{api}}/appointments
Content-Type: {{json}}

{
  "customerId": "CUS-10482",
  "vehicleId": "VEH-01",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{today}}",
  "startTime": "11:00",
  "bookingSessionId": "44444444-4444-4444-8444-444444444444"
}

###
# Restock => 200 onHand 10
PUT {{api}}/dealerships/DLR-01/inventory/FLT-OIL-CX22
Content-Type: {{json}}

{ "onHand": 10 }

###
# Same-day booking now succeeds: 201, channel SAME_DAY, parts reserved (parts: [...])
# @name bookSameDay
POST {{api}}/appointments
Content-Type: {{json}}

{
  "customerId": "CUS-10482",
  "vehicleId": "VEH-01",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{today}}",
  "startTime": "11:00",
  "bookingSessionId": "44444444-4444-4444-8444-444444444444"
}

###
@sameDayReference = {{bookSameDay.response.body.reference}}

# Earlier than the 2 h lead time (09:30 when "now" is 09:00): 422 LEAD_TIME_NOT_MET
POST {{api}}/appointments
Content-Type: {{json}}

{
  "customerId": "CUS-10001",
  "vehicleId": "VEH-03",
  "dealershipId": "DLR-01",
  "serviceTypeCode": "OIL_CHANGE",
  "date": "{{today}}",
  "startTime": "09:30",
  "bookingSessionId": "55555555-5555-4555-8555-555555555555"
}

### 8. Board -------------------------------------------------------------------------------------------

# 200: day timeline per bay and per technician, including the same-day booking above
GET {{api}}/dealerships/DLR-01/board?date={{today}}

###
# Release the same-day booking (frees bay, technician and reserved parts): 200 CANCELLED
POST {{api}}/appointments/{{sameDayReference}}/cancel

### 9. Operations --------------------------------------------------------------------------------------

GET {{base}}/health/live

###
GET {{base}}/health/ready

###
# Prometheus text: http_request_duration_seconds, booking_attempts_total{outcome,reason,channel}, booking_reserve_duration_seconds, ...
# See docs/observability.md
GET {{base}}/metrics

###
# Swagger UI (the OpenAPI document is committed at docs/openapi.yaml)
GET {{base}}/docs
