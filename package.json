{
  "name": "service-scheduler",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @scheduler/api --filter @scheduler/web dev",
    "dev:mock": "pnpm --filter @scheduler/web dev",
    "dev:real": "VITE_USE_MOCKS=false VITE_API_URL=http://localhost:3000 pnpm dev",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "pnpm --filter @scheduler/api db:up",
    "db:migrate": "pnpm --filter @scheduler/api db:migrate",
    "db:seed": "pnpm --filter @scheduler/api db:seed",
    "coverage": "pnpm -r test:coverage",
    "e2e": "playwright test",
    "loadtest:seed": "pnpm --filter @scheduler/api exec tsx ../../loadtest/seed-load.ts",
    "loadtest:run": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e BASE_URL -e DURATION -e BROWSE_RATE -e CONTEND_VUS -e LT_CUSTOMERS -e DAYS -v \"$PWD/loadtest:/loadtest:ro\" grafana/k6:1.2.1 run /loadtest/booking.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
